{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ride-the-api.dev/capture-schema/v1",
  "title": "Ride-the-API Capture DB",
  "description": "Portable raw capture format (.ride-capture.json) for sharing intercepted device traffic.",
  "type": "object",
  "required": ["$schema", "meta", "sessions"],
  "properties": {
    "$schema": {
      "const": "https://ride-the-api.dev/capture-schema/v1"
    },
    "meta": {
      "type": "object",
      "required": ["capture_id", "vendor", "device_type", "capture_date"],
      "properties": {
        "version": { "type": "integer", "const": 1 },
        "capture_id": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "device_type": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "firmware_version": { "type": "string" },
        "capture_date": { "type": "string", "format": "date-time" },
        "description": { "type": "string" }
      }
    },
    "device_info": {
      "type": "object",
      "properties": {
        "device_id": { "type": "string" },
        "mac": { "type": "string" },
        "serial": { "type": "string" }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["session_id", "timestamp_start"],
        "properties": {
          "session_id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["boot", "command", "polling", "handshake", "capture"]
          },
          "timestamp_start": { "type": "string", "format": "date-time" },
          "pairs": {
            "type": "array",
            "items": { "$ref": "#/$defs/pair" }
          }
        }
      }
    }
  },
  "$defs": {
    "protocols": {
      "type": "string",
          "enum": ["http", "https", "mqtt", "coap", "modbus", "websocket", "raw_tcp", "http2", "zigbee", "zwave", "matter"]
    },
    "pair": {
      "type": "object",
      "required": ["pair_id", "timestamp", "protocol", "path"],
      "properties": {
        "pair_id": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "protocol": { "$ref": "#/$defs/protocols" },
        "method": { "type": "string" },
        "path": { "type": "string" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "query_params": { "type": "object" },
        "body": {},
        "response": {
          "type": "object",
          "properties": {
            "status_code": { "type": "integer" },
            "headers": { "type": "object" },
            "body": {},
            "latency_ms": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
