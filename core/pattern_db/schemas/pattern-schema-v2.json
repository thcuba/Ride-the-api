{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ride-the-api.dev/pattern-schema/v2",
  "title": "Ride-the-API DeviceModel",
  "description": "Portable DeviceModel format (.ride-pattern.json v2) — learned, portable knowledge of a device sufficient to clone it on another installation without re-learning. Reuses v1 building blocks (state_variable, field_mapping, server_response, virtual_sensor) and adds protocol identification and protocol-agnostic commands.",
  "type": "object",
  "required": ["$schema", "meta"],
  "properties": {
    "$schema": {
      "const": "https://ride-the-api.dev/pattern-schema/v2"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "protocol": {
      "$ref": "#/$defs/protocol_info"
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "responses": {
      "type": "array",
      "items": { "$ref": "#/$defs/server_response" }
    },
    "interactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/field_mapping" }
    },
    "state_variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/state_variable" }
    },
    "virtual_sensors": {
      "type": "array",
      "items": { "$ref": "#/$defs/virtual_sensor" }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["pattern_id", "vendor", "device_type"],
      "properties": {
        "version": { "type": "integer" },
        "pattern_id": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "device_type": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "firmware_versions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "type": "string" }
      }
    },
    "protocol_info": {
      "type": "object",
      "properties": {
        "version": { "type": "integer" },
        "transport": { "type": "string" },
        "protocol": { "type": "string" },
        "proprietary": { "type": "boolean" },
        "security": { "type": "string" },
        "handler": { "type": "string" },
        "identity": { "type": "string" },
        "ports": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "command": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string" },
        "method": { "type": "string" },
        "path": { "type": "string" },
        "path_pattern": { "type": "string" },
        "topic": { "type": "string" },
        "headers": {
          "type": "object",
          "properties": {
            "required": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "query_params": {
          "type": "array",
          "items": { "type": "string" }
        },
        "body_schema": { "type": "object" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "state_variable": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["boolean", "integer", "float", "string", "enum"]
        },
        "default": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "enum": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unit": { "type": "string" },
        "persist": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "field_mapping": {
      "type": "object",
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "transform": {
          "type": "string",
          "enum": ["direct", "enum", "formula", "scale"]
        },
        "formula": { "type": "string" },
        "mapping": { "type": "object" },
        "description": { "type": "string" }
      }
    },
    "server_response": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status_code": { "type": "integer" },
        "headers_template": { "type": "object" },
        "body_template": { "type": "object" },
        "field_mappings": {
          "type": "array",
          "items": { "$ref": "#/$defs/field_mapping" }
        }
      }
    },
    "virtual_sensor": {
      "type": "object",
      "required": ["name", "behavior"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["integer", "float", "boolean"]
        },
        "behavior": {
          "type": "string",
          "enum": ["static", "drift", "periodic", "random"]
        },
        "baseline": { "type": "string" },
        "drift_range": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "period_s": { "type": "number", "minimum": 0 },
        "amplitude": { "type": "number" },
        "update_interval_s": { "type": "number", "minimum": 0 },
        "description": { "type": "string" }
      }
    }
  }
}